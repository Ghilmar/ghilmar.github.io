---
import Icon from './Icon.astro';
import { profile } from '../lib/profile';
---

<footer class="border-t border-base-200/70 dark:border-base-800/70">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
    <p class="font-mono text-xs text-base-400">
      © {new Date().getFullYear()} {profile.name} · Informático
    </p>
    <p class="flex items-center gap-1.5 font-mono text-xs text-base-400">
      Construido con
      <Icon name="code" size={13} class="text-accent-500 dark:text-accent-400" />
      Astro · TypeScript · Tailwind CSS
    </p>
    <a
      href="#inicio"
      class="inline-flex items-center gap-1.5 rounded-md border border-base-200 px-3 py-1.5 font-mono text-xs text-base-500 transition-colors hover:border-accent-500 hover:text-accent-500 dark:border-base-800 dark:text-base-300"
      aria-label="Volver al inicio"
    >
      <Icon name="arrow-up" size={13} />
      Inicio
    </a>
  </div>
</footer>