---
import { downloadCvHref, profile } from '../lib/profile';
import Icon from './Icon.astro';

const personal = [
  { label: 'Fecha de nacimiento', value: profile.personalInfo.birthDate },
  { label: 'Lugar', value: profile.personalInfo.birthPlace },
  { label: 'Estado civil', value: profile.personalInfo.maritalStatus },
  { label: 'Carnet de identidad', value: profile.personalInfo.idNumber },
];
---

<section id="contacto" class="scroll-mt-20 border-t border-base-200/70 bg-base-100/50 py-20 dark:border-base-800/70 dark:bg-base-900/30">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-sm text-accent-500 dark:text-accent-400">$ echo "Hablemos de tecnología"</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Contacto</h2>
      <p class="mt-3 max-w-2xl text-base text-base-500 dark:text-base-300">
        ¿Tienes una oportunidad, un proyecto o alguna consulta? Estoy disponible para conversar.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="reveal space-y-4">
        <a
          href={`mailto:${profile.email}`}
          class="group flex items-center gap-4 rounded-xl border border-base-200 bg-white p-5 shadow-sm transition-colors hover:border-accent-500/50 dark:border-base-800 dark:bg-base-900"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-500/10 text-accent-500 dark:text-accent-400"
            aria-hidden="true"
          >
            <Icon name="mail" size={20} />
          </span>
          <span>
            <span class="block font-mono text-xs text-base-400">email</span>
            <span class="block text-sm font-medium text-base-700 group-hover:text-accent-500 dark:text-base-200 dark:group-hover:text-accent-400">
              {profile.email}
            </span>
          </span>
        </a>

        <div class="flex items-center gap-4 rounded-xl border border-base-200 bg-white p-5 shadow-sm dark:border-base-800 dark:bg-base-900">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-500/10 text-accent-500 dark:text-accent-400"
            aria-hidden="true"
          >
            <Icon name="map-pin" size={20} />
          </span>
          <span>
            <span class="block font-mono text-xs text-base-400">ubicación</span>
            <span class="block text-sm font-medium text-base-700 dark:text-base-200">
              {profile.location}
            </span>
          </span>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={downloadCvHref}
            download
            class="inline-flex items-center gap-2 rounded-md bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-600"
          >
            <Icon name="download" size={16} />
            Descargar CV en PDF
          </a>
          {
            profile.socialLinks.github && (
              <a
                href={profile.socialLinks.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-md border border-base-300 px-5 py-2.5 text-sm font-semibold text-base-700 transition-colors hover:border-accent-500 hover:text-accent-500 dark:border-base-700 dark:text-base-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
              >
                <Icon name="github" size={16} />
                GitHub
              </a>
            )
          }
          {
            profile.socialLinks.linkedin && (
              <a
                href={profile.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-md border border-base-300 px-5 py-2.5 text-sm font-semibold text-base-700 transition-colors hover:border-accent-500 hover:text-accent-500 dark:border-base-700 dark:text-base-200 dark:hover:border-accent-400 dark:hover:text-accent-400"
              >
                <Icon name="linkedin" size={16} />
                LinkedIn
              </a>
            )
          }
        </div>
      </div>

      <article class="reveal rounded-xl border border-base-200 bg-white p-6 shadow-sm dark:border-base-800 dark:bg-base-900">
        <h3 class="font-mono text-sm font-semibold text-base-800 dark:text-base-100">
          Información personal
        </h3>
        <dl class="mt-4 divide-y divide-base-100 dark:divide-base-800">
          {
            personal.map((item) => (
              <div class="flex items-center justify-between gap-4 py-3">
                <dt class="font-mono text-xs text-base-400">{item.label}</dt>
                <dd class="text-right text-sm font-medium text-base-700 dark:text-base-200">
                  {item.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>
  </div>
</section>