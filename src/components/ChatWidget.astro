---
import { profile } from '../lib/profile';
import Icon from './Icon.astro';

const firstName = profile.name.split(' ')[0];
const greeting = `¡Hola! Soy el asistente IA de ${firstName}. Puedo responder preguntas sobre su perfil, experiencia, proyectos y tecnologías.`;
---

<div class="chat-widget fixed bottom-5 right-5 z-50" data-greeting={greeting}>
  <div
    id="chat-panel"
    class="pointer-events-none invisible flex translate-y-3 flex-col overflow-hidden rounded-xl border border-base-200 bg-white opacity-0 shadow-2xl transition-all duration-200 dark:border-base-700 dark:bg-base-900"
    style="width: min(92vw, 24rem); height: 32rem;"
    role="dialog"
    aria-label="Asistente IA del portafolio"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between border-b border-base-200 bg-base-50 px-4 py-3 dark:border-base-800 dark:bg-base-850">
      <div class="flex items-center gap-2.5">
        <span
          class="flex h-8 w-8 items-center justify-center rounded-md bg-accent-500/10 text-accent-500 dark:text-accent-400"
          aria-hidden="true"
        >
          <Icon name="sparkles" size={16} />
        </span>
        <div>
          <p class="text-sm font-semibold leading-tight text-base-800 dark:text-base-50">
            Asistente de {profile.name.split(' ')[0]}
          </p>
          <p id="chat-status" class="font-mono text-[11px] text-base-400">
            conectando…
          </p>
        </div>
      </div>
      <button
        id="chat-close"
        type="button"
        aria-label="Cerrar asistente"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md text-base-400 transition-colors hover:bg-base-200/60 hover:text-base-800 dark:hover:bg-base-800 dark:hover:text-base-100"
      >
        <Icon name="x" size={16} />
      </button>
    </div>

    <div
      id="chat-messages"
      class="flex-1 space-y-3 overflow-y-auto p-4"
      aria-live="polite"
    ></div>

    <form id="chat-form" class="border-t border-base-200 p-3 dark:border-base-800">
      <label for="chat-input" class="sr-only">Escribe tu pregunta</label>
      <div class="flex items-center gap-2">
        <input
          id="chat-input"
          type="text"
          autocomplete="off"
          placeholder="Pregunta sobre mi perfil…"
          class="w-full rounded-md border border-base-300 bg-base-50 px-3 py-2 text-sm text-base-800 placeholder:text-base-400 focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500 dark:border-base-700 dark:bg-base-850 dark:text-base-100"
        />
        <button
          type="submit"
          id="chat-send"
          aria-label="Enviar pregunta"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-accent-500 text-white transition-colors hover:bg-accent-600 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <Icon name="send" size={15} />
        </button>
      </div>
    </form>
  </div>

  <button
    id="chat-toggle"
    type="button"
    aria-label="Abrir asistente IA"
    aria-expanded="false"
    class="mt-3 inline-flex h-12 w-12 items-center justify-center rounded-full bg-accent-500 text-white shadow-lg transition-transform hover:scale-105 hover:bg-accent-600"
  >
    <Icon name="chat" size={20} />
    <span class="sr-only">Asistente IA</span>
  </button>
</div>

<script>
  import { askAssistant, AI_AVAILABLE } from '../lib/ai-client';

  const panel = document.getElementById('chat-panel') as HTMLElement | null;
  const toggle = document.getElementById('chat-toggle') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('chat-close') as HTMLButtonElement | null;
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLInputElement | null;
  const messages = document.getElementById('chat-messages') as HTMLElement | null;
  const status = document.getElementById('chat-status') as HTMLElement | null;

  if (status) {
    status.textContent = AI_AVAILABLE ? 'en línea' : 'no disponible';
  }

  function setPanel(open: boolean) {
    if (!panel || !toggle) return;
    panel.classList.toggle('invisible', !open);
    panel.classList.toggle('pointer-events-none', !open);
    panel.classList.toggle('opacity-0', !open);
    panel.classList.toggle('translate-y-3', !open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar asistente IA' : 'Abrir asistente IA');
    if (open) {
      input?.focus();
      welcome();
    }
  }

  function bubble(text: string, kind: 'user' | 'assistant') {
    if (!messages) return;
    const row = document.createElement('div');
    row.className =
      kind === 'user'
        ? 'flex justify-end'
        : 'flex justify-start';
    const el = document.createElement('div');
    el.className =
      kind === 'user'
        ? 'max-w-[85%] rounded-lg rounded-tr-none bg-accent-500 px-3 py-2 text-sm text-white'
        : 'max-w-[85%] rounded-lg rounded-tl-none border border-base-200 bg-base-50 px-3 py-2 text-sm text-base-700 dark:border-base-800 dark:bg-base-850 dark:text-base-200';
    el.textContent = text;
    row.appendChild(el);
    messages.appendChild(row);
    messages.scrollTop = messages.scrollHeight;
  }

  let greeted = false;
  function welcome() {
    if (!greeted) {
      greeted = true;
      bubble(
        panel?.closest('.chat-widget')?.getAttribute('data-greeting') ??
          '¡Hola! Soy el asistente IA. ¿En qué puedo ayudarte?',
        'assistant',
      );
    }
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setPanel(!open);
  });

  closeBtn?.addEventListener('click', () => setPanel(false));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const question = input?.value.trim();
    if (!question || !messages) return;

    bubble(question, 'user');
    if (input) input.value = '';

    const typing = document.createElement('div');
    typing.className = 'flex justify-start';
    const typingEl = document.createElement('div');
    typingEl.className =
      'max-w-[85%] rounded-lg rounded-tl-none border border-base-200 bg-base-50 px-3 py-2 font-mono text-xs text-base-400 dark:border-base-800 dark:bg-base-850';
    typingEl.textContent = '◆  Escribiendo…';
    typing.appendChild(typingEl);
    messages.appendChild(typing);
    messages.scrollTop = messages.scrollHeight;

    try {
      const answer = await askAssistant(question);
      typing.remove();
      bubble(answer, 'assistant');
    } catch (err) {
      typing.remove();
      // No exponer errores técnicos internos al visitante (SKILL Nivel 17).
      bubble(
        'El asistente de IA no está disponible en este momento. Puedes consultar directamente mi perfil, proyectos y CV.',
        'assistant',
      );
      console.warn('[chat] Respuesta de IA no disponible:', err);
    }
  });
</script>