---
import { profile } from '../lib/profile';
import Icon from './Icon.astro';

const { projects } = profile;
---

<section id="proyectos" class="scroll-mt-20 border-y border-base-200/70 bg-base-100/50 py-20 dark:border-base-800/70 dark:bg-base-900/30">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="font-mono text-sm text-accent-500 dark:text-accent-400">$ ls ~/projects --detail</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Proyectos</h2>
      <p class="mt-3 max-w-2xl text-base text-base-500 dark:text-base-300">
        Cada proyecto se resume como caso de estudio: problema, solución, tecnologías y resultados.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        projects.map((project, index) => (
          <article
            class:list={[
              'reveal flex flex-col overflow-hidden rounded-xl border border-base-200 bg-white shadow-sm transition-all dark:border-base-800 dark:bg-base-900',
              'hover:border-accent-500/40 hover:shadow-md dark:hover:border-accent-400/40',
            ]}
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center justify-between gap-3">
                <span
                  class="rounded border border-accent-500/30 bg-accent-500/10 px-2 py-0.5 font-mono text-xs text-accent-600 dark:text-accent-400"
                >
                  {project.category}
                </span>
                {project.company && (
                  <span class="font-mono text-xs text-base-400">{project.company}</span>
                )}
              </div>

              <h3 class="mt-4 text-xl font-bold tracking-tight text-base-800 dark:text-base-50">
                {project.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-base-500 dark:text-base-300">
                {project.description}
              </p>

              {
                project.problem && (
                  <div class="mt-5">
                    <h4 class="flex items-center gap-1.5 font-mono text-xs font-semibold text-warning-400">
                      <Icon name="terminal" size={13} /> Problema
                    </h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-base-500 dark:text-base-300">{project.problem}</p>
                  </div>
                )
              }
              {
                project.solution && (
                  <div class="mt-4">
                    <h4 class="flex items-center gap-1.5 font-mono text-xs font-semibold text-accent-500 dark:text-accent-400">
                      <Icon name="code" size={13} /> Solución
                    </h4>
                    <p class="mt-1.5 text-sm leading-relaxed text-base-500 dark:text-base-300">{project.solution}</p>
                  </div>
                )
              }
              {
                project.result && (
                  <div class="mt-4">
                    <h4 class="flex items-center gap-1.5 font-mono text-xs font-semibold text-success-400">
                      <Icon name="arrow" size={13} /> Resultado
                    </h4>
                    <p class="mt-1.5 font-mono text-sm text-base-500 dark:text-base-300">{project.result}</p>
                  </div>
                )
              }

              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías del proyecto">
                {
                  project.technologies.map((tech) => (
                    <li
                      class="rounded-md bg-base-100 px-2.5 py-1 font-mono text-xs text-base-500 dark:bg-base-850 dark:text-base-300"
                    >
                      {tech}
                    </li>
                  ))
                }
              </ul>

              {
                (project.github || project.demo) && (
                  <div class="mt-6 flex flex-wrap gap-3 border-t border-base-100 pt-5 dark:border-base-800">
                    {project.github && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-medium text-base-600 transition-colors hover:text-accent-500 dark:text-base-300 dark:hover:text-accent-400"
                      >
                        <Icon name="github" size={16} />
                        Ver código en GitHub
                        <Icon name="external-link" size={12} />
                      </a>
                    )}
                    {project.demo && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-medium text-base-600 transition-colors hover:text-accent-500 dark:text-base-300 dark:hover:text-accent-400"
                      >
                        <Icon name="external-link" size={16} />
                        Ver Demo
                      </a>
                    )}
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>