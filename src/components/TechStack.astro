---
import { profile } from "../lib/profile";
import Icon from "./Icon.astro";
---

<section id="tecnologias" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6">
  <div class="reveal">
    <p class="font-mono text-sm text-accent-500 dark:text-accent-400">$ ls ~/tech-stack</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      Tecnologías
    </h2>
    <p class="mt-3 max-w-2xl text-base text-base-500 dark:text-base-300">
      Conocimientos organizados por categorías. Aprendizaje continuo como principio de trabajo.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      profile.techStack.categories.map((category, index) => (
        <article
          class:list={[
            'reveal rounded-xl border border-base-200 bg-white p-6 shadow-sm transition-colors dark:border-base-800 dark:bg-base-900',
            'hover:-translate-y-0.5',
          ]}
          style={`transition-delay: ${index * 80}ms`}
        >
          <h3 class="font-mono text-sm font-semibold text-base-800 dark:text-base-100">
            {category.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-base-400 dark:text-base-400">
            {category.description}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              category.items.map((item) => (
                <li>
                  <span
                    class="group inline-flex items-center gap-2 rounded-md border border-base-200 bg-base-50 px-3 py-1.5 font-mono text-xs text-base-600 transition-colors hover:border-accent-500/50 hover:text-accent-500 dark:border-base-800 dark:bg-base-850 dark:text-base-300 dark:hover:border-accent-400/50 dark:hover:text-accent-400"
                    title={item.name}
                  >
                    {item.icon && <Icon name={item.icon} size={14} />}
                    {item.name}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>
      ))
    }
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <article class="reveal rounded-xl border border-base-200 bg-white p-6 shadow-sm dark:border-base-800 dark:bg-base-900">
      <h3 class="flex items-center gap-2 font-mono text-sm font-semibold text-base-800 dark:text-base-100">
        <Icon name="chat" size={16} class="text-accent-500 dark:text-accent-400" />
        Idiomas
      </h3>
      <ul class="mt-4 space-y-2">
        {
          profile.languages.map((lang) => (
            <li class="flex items-center justify-between">
              <span class="text-sm text-base-600 dark:text-base-300">{lang.name}</span>
              <span class="rounded border border-base-200 px-2 py-0.5 font-mono text-xs text-accent-600 dark:border-base-700 dark:text-accent-400">
                {lang.level}
              </span>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="reveal rounded-xl border border-base-200 bg-white p-6 shadow-sm dark:border-base-800 dark:bg-base-900">
      <h3 class="flex items-center gap-2 font-mono text-sm font-semibold text-base-800 dark:text-base-100">
        <Icon name="sparkles" size={16} class="text-accent-500 dark:text-accent-400" />
        Intereses
      </h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          profile.interests.map((interest) => (
            <li
              class="rounded-md bg-base-100 px-3 py-1.5 text-xs text-base-600 dark:bg-base-850 dark:text-base-300"
            >
              {interest}
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>