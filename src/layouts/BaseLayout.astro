---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '@fontsource/fira-code/600.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gilmar Betancur · Informático | Desarrollador Junior',
  description = 'Portafolio profesional de Gilmar Betancur, Informático y Desarrollador Junior especializado en aplicaciones web.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_BO" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {
          /* almacenamiento no disponible */
        }
        var dark = stored ? stored === 'dark' : true;
        var root = document.documentElement;
        root.classList.add('js');
        root.classList.toggle('dark', dark);
        root.dataset.theme = dark ? 'dark' : 'light';
        root.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="bg-base-50 text-base-800 dark:bg-base-950 dark:text-base-100">
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
    <script>
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>