# ------------------------------------------------------------------
# Entorno FRONTEND (Astro). Copia a .env.local y ajusta.
# PUBLIC_AI_API_URL es la URL del proxy del asistente (ver server/).
# Dejar vacío hace que el chat muestre el fallback elegante.
# ------------------------------------------------------------------
PUBLIC_AI_API_URL=http://localhost:8787/api/chat

# ------------------------------------------------------------------
# Configuración de GitHub Pages (también se pueden definir como
# variables del repositorio en GitHub Actions: SITE_URL y BASE_PATH).
# ------------------------------------------------------------------
# Valores por defecto ya correctos en astro.config.mjs (ghilmar.github.io, base /).
# Sólo se definen aquí para sobreescribir (p. ej. repo de proyecto o staging).
SITE_URL=https://ghilmar.github.io
BASE_PATH=/

# ------------------------------------------------------------------
# Entorno BACKEND (server/.env — NO comprometer ni subir a Git).
# ------------------------------------------------------------------
# URL base de un proveedor compatible con OpenAI Chat Completions.
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1   (endpoint OpenAI-compatible)
AI_API_URL=https://api.groq.com/openai/v1
# Clave de API del proveedor (se lee solo en el servidor proxy).
AI_API_KEY=
# Modelo a usar (según los modelos disponibles en tu proveedor).
AI_MODEL=openai/gpt-oss-120b
PORT=8787